    "verify": "node scripts/verify-build.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.5",
    "astro": "7.4.4",
    "github-slugger": "2.0.0",
    "katex": "0.19.1",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0",
    "unist-util-visit": "5.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/node": "24.19.2",
    "pagefind": "1.5.2",
    "typescript": "5.9.3"
  },
  "overrides": { "katex": "$katex" }
}
