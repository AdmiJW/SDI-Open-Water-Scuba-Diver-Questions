---
const breathBubbles = [
  { r: 2.2, drift: 14, rise: 168, duration: 5.8, delay: -1.2 },
  { r: 3.8, drift: 26, rise: 194, duration: 7.1, delay: -4.4 },
  { r: 2.7, drift: 5, rise: 175, duration: 6.4, delay: -3.1 },
  { r: 4.6, drift: 34, rise: 188, duration: 7.7, delay: -6.8 },
  { r: 1.8, drift: 19, rise: 163, duration: 5.2, delay: -4.1 },
  { r: 3.1, drift: -6, rise: 181, duration: 6.8, delay: -.6 },
  { r: 2.3, drift: 23, rise: 198, duration: 7.3, delay: -5.1 },
  { r: 4, drift: 11, rise: 174, duration: 6.1, delay: -2.4 },
];
const waterBubbles = [
  { x: 100, y: 380, r: 3, drift: -18, rise: 260, duration: 14, delay: -8 },
  { x: 145, y: 399, r: 1.8, drift: 13, rise: 290, duration: 18, delay: -3 },
  { x: 445, y: 363, r: 3.3, drift: 19, rise: 240, duration: 16, delay: -11 },
  { x: 479, y: 411, r: 2.2, drift: -12, rise: 300, duration: 19, delay: -7 },
];
// Staggered negative delays make the water feel alive immediately.
const bubbleStyle = (b: (typeof breathBubbles)[number]) => `--drift:${b.drift}px;--rise:-${b.rise}px;--duration:${b.duration}s;--delay:${b.delay}s;`;
---
<div class="ocean-scene" aria-hidden="true">
  <div class="light-ray ray-one"></div><div class="light-ray ray-two"></div>
  <svg viewBox="0 0 560 460" fill="none" class="ocean-illustration">
    <defs>
      <radialGradient id="sea-glow"><stop stop-color="#4fdac5" stop-opacity=".18"/><stop offset="1" stop-color="#4fdac5" stop-opacity="0"/></radialGradient>
      <linearGradient id="sea-floor" x2="0" y2="1"><stop stop-color="#15565e"/><stop offset="1" stop-color="#071c29"/></linearGradient>
      <linearGradient id="wetsuit" x1="212" y1="193" x2="276" y2="281" gradientUnits="userSpaceOnUse"><stop stop-color="#37555d"/><stop offset=".45" stop-color="#19343f"/><stop offset="1" stop-color="#0c212e"/></linearGradient>
      <linearGradient id="cylinder" x1="258" y1="174" x2="269" y2="207" gradientUnits="userSpaceOnUse"><stop stop-color="#a0baba"/><stop offset=".25" stop-color="#d3dfd8"/><stop offset=".55" stop-color="#8ca5a4"/><stop offset="1" stop-color="#3a5960"/></linearGradient>
      <linearGradient id="fin" x1="137" y1="263" x2="178" y2="290" gradientUnits="userSpaceOnUse"><stop stop-color="#74cabb"/><stop offset="1" stop-color="#286c71"/></linearGradient>
      <linearGradient id="mask-glass" x1="339" y1="198" x2="353" y2="218" gradientUnits="userSpaceOnUse"><stop stop-color="#b5e5d4"/><stop offset=".4" stop-color="#5aada9"/><stop offset="1" stop-color="#24505f"/></linearGradient>
      <radialGradient id="bubble-glass" cx=".3" cy=".25"><stop stop-color="#c4f6eb" stop-opacity=".28"/><stop offset=".65" stop-color="#93e3da" stop-opacity=".03"/><stop offset="1" stop-color="#b6f1e7" stop-opacity=".12"/></radialGradient>
    </defs>
    <circle cx="290" cy="215" r="210" fill="url(#sea-glow)"/>
    <g stroke="#72cfc8" stroke-opacity=".16">
      <circle cx="291" cy="213" r="156"/><circle cx="291" cy="213" r="119" stroke-dasharray="2 9"/>
      <path d="M291 35v26m0 304v26M113 213h25m304 0h26"/>
      <path d="M90 340h350M90 290h35m300 0h42M90 240h25m319 0h33" stroke-dasharray="2 5"/>
    </g>
    <g fill="#8bddd2" font-family="monospace" font-size="10" letter-spacing="2" opacity=".65">
      <text x="283" y="24">N</text><text x="449" y="294">10 M</text><text x="449" y="344">20 M</text>
    </g>
    <g class="ambient-bubble-field">
      {waterBubbles.map((b) => <circle class="rising-bubble" cx={b.x} cy={b.y} r={b.r} style={bubbleStyle(b)} />)}
    </g>

    <g class="diver-rig" stroke-linecap="round" stroke-linejoin="round">
      <!-- Far arm and leg, behind the fitted suit and padded buoyancy jacket. -->
      <path d="M303 216c11 2 18 8 23 17l17 8 14-4 3 6-17 6c-3 1-6 0-8-1l-21-10-18-14z" fill="#18323d" stroke="#477277" stroke-width=".8"/>
      <g class="far-leg">
        <path d="M253 233c-12 0-20 7-30 18l-22 18-31-8-5 11 38 13c5 1 8-1 11-4l37-24 14-14z" fill="#16303b" stroke="#365961" stroke-width="1"/>
        <path d="m173 261-13-5-8 6 9 12 9-2z" fill="#102731"/>
        <path d="m158 258-31-17-13 4 16 19 27 8 7-7z" fill="#286e71" stroke="#60ada4" stroke-width=".9"/>
        <path d="m122 246 30 17m-24-19 29 17" stroke="#133f4b" stroke-width="1.4"/>
      </g>
      <path d="M258 208c12-10 31-13 45-9l14 10-2 20-23 14-32 12-21-11 4-21z" fill="url(#wetsuit)" stroke="#5d8b8d" stroke-width="1.1"/>
      <path d="M267 201c11-6 27-7 36-3l10 9-3 19-15 11-25 9-12-13 2-22z" fill="#102a36" stroke="#4c7378" stroke-width="1.1"/>
      <path d="M273 205c-5 11-4 25 3 33m27-35c5 7 3 16-2 25" stroke="#85b6b0" stroke-opacity=".65" stroke-width="3"/>
      <path d="M259 232c11 3 23 2 34-2" stroke="#0a1b25" stroke-width="7"/>
      <rect x="276" y="229" width="9" height="6" rx="1" transform="rotate(-12 276 229)" fill="#8aa7a4"/>
      <rect x="279" y="230" width="3" height="3" rx=".5" fill="#19363f"/>

      <!-- Aluminium cylinder, retaining bands, valve, and first stage. -->
      <g transform="rotate(-17 273 194)">
        <path d="M244 181h52c8 0 14 5 14 12s-6 12-14 12h-52c-5 0-9-5-9-12s4-12 9-12z" fill="url(#cylinder)" stroke="#b0c9c0" stroke-width=".8"/>
        <path d="M244 185h47" stroke="#f0f4df" stroke-opacity=".6" stroke-width="1.4"/>
        <path d="M254 181v24m34-24v24" stroke="#16333d" stroke-width="6"/>
        <path d="M253 182v22m34-22v22" stroke="#6b9593" stroke-width="1"/>
        <rect x="305" y="189" width="10" height="8" rx="2" fill="#b3c3b5"/>
        <path d="M310 189v-7m-4 0h8" stroke="#8fb6b2" stroke-width="2.3"/>
        <rect x="314" y="189" width="7" height="9" rx="2" fill="#19333e" stroke="#73958f" stroke-width=".8"/>
      </g>
      <path d="M315 184c22-4 14 31 35 34" stroke="#091b26" stroke-width="5"/>
      <path d="M315 184c22-4 14 31 35 34" stroke="#7eaaa5" stroke-width="1.4"/>
      <path d="M311 187c-8 0-12 6-12 16l-1 16" stroke="#172d38" stroke-width="5"/>
      <path d="M311 187c-8 0-12 6-12 16l-1 16" stroke="#77958f" stroke-width="1.1"/>
      <path d="M310 191c23 10 12 54-2 51" stroke="#b1a86b" stroke-width="2.5"/>
      <circle cx="308" cy="241" r="4" fill="#d1b970" stroke="#1d3b43" stroke-width="2"/>

      <!-- Hood, exposed face, mask skirt and reflective lens, second stage. -->
      <path d="m307 204 13-8 9 8-7 15-15 7-8-11z" fill="#142e39"/>
      <path d="M319 190c8-7 20-5 26 2 4 4 5 10 4 15l8 8-4 4-4 9-9 2-12-8-8-10c-6-8-6-16-1-22z" fill="#9bb4a6"/>
      <path d="M318 190c8-7 20-5 26 2l4 10-12-4-9 9-3 12-7-8c-6-8-5-15 1-21z" fill="#15323f" stroke="#79a9a4" stroke-width="1"/>
      <path d="m319 201 17 7" stroke="#0b2431" stroke-width="4"/>
      <path d="m338 199 12 3 7 10-6 7-14-6-3-8z" fill="#12313d" stroke="#9bcac1" stroke-width="1.7"/>
      <path d="m340 202 8 2 6 8-4 4-10-5-3-6z" fill="url(#mask-glass)"/>
      <path d="m340 203 8 3" stroke="#d4f3de" stroke-opacity=".8" stroke-width="1.2"/>
      <path d="m347 221 6-5 8 3 1 7-6 4-8-3z" fill="#0d2936" stroke="#94b6ae" stroke-width="1.2"/>
      <circle cx="356" cy="223" r="3.2" fill="#476971"/><path d="m355 221 3 3" stroke="#a9c8bd" stroke-width=".8"/>

      <g class="near-leg">
        <path d="M256 235c-11 0-19 6-26 16l-18 26-35 10 3 14 44-10c5-1 8-5 10-8l29-28c7-8 3-18-7-20z" fill="url(#wetsuit)" stroke="#62908f" stroke-width="1.1"/>
        <path d="M253 240c-10 4-16 14-24 26l-11 17-31 9" stroke="#68a59e" stroke-opacity=".7" stroke-width="1.7"/>
        <path d="m218 272 11 7" stroke="#132c38" stroke-width="6"/>
        <path d="m178 286-13 4-4 9 8 7 14-6z" fill="#102b36" stroke="#79a6a0" stroke-width=".8"/>
        <path d="m165 292-38-7-18 8 9 12 42 2 9-9z" fill="url(#fin)" stroke="#82c7b8" stroke-width="1"/>
        <path d="m121 291 35 7m-35 1 35 2m-30-13 34 7" stroke="#275661" stroke-width="1.2"/>
        <path d="m163 293-3 11" stroke="#0b2d3b" stroke-width="4"/>
      </g>

      <!-- Relaxed forearm, wrist computer, and articulated gloved hand. -->
      <path d="M301 216c6-3 12-1 15 4l12 22 24 8-3 10-29-8c-4-1-7-3-9-7l-16-18c-3-4-1-8 6-11z" fill="url(#wetsuit)" stroke="#6c9794" stroke-width="1.1"/>
      <path d="m302 220 17 25 22 8" stroke="#76a9a0" stroke-opacity=".65" stroke-width="1.7"/>
      <path d="m342 248-2 10" stroke="#0a222f" stroke-width="7"/>
      <rect x="339" y="249" width="8" height="7" rx="2" transform="rotate(16 339 249)" fill="#93b9ae"/>
      <rect x="341" y="250" width="4" height="4" rx=".7" transform="rotate(16 341 250)" fill="#163b45"/>
      <path d="m351 250 12 2 5 6-3 3-10-2-5-2z" fill="#254650" stroke="#6d9d95" stroke-width=".8"/>
      <path d="m359 254 6 3m-8 0 6 2" stroke="#8db2a6" stroke-width=".7"/>
    </g>

    <g class="breath-bubble-field">
      {breathBubbles.map((b) => <g class="rising-bubble" style={bubbleStyle(b)}><circle cx="363" cy="218" r={b.r} /><path d={`M${363 - b.r * .5} ${218 - b.r * .25}q0-${b.r * .45} ${b.r * .5}-${b.r * .45}`} /></g>)}
    </g>
    <path d="M37 424q90-52 176-20t170-10q57-27 126 8v58H37z" fill="url(#sea-floor)"/>
    <g stroke="#227879" stroke-width="5" stroke-linecap="round">
      <path d="M96 435q14-49 0-95m2 57-18-20m19 2 17-26M427 430v-76m0 42-20-19m20 3 20-23M463 439q-8-41 8-60m-9 31 20-9"/>
    </g>
    <g class="reef-fish" fill="#66bab2" opacity=".6"><path d="m402 162 13-5-3 6 2 6zM429 150l11-4-2 5 2 4zM420 178l10-3-2 4 1 4z"/></g>
  </svg>
  <span class="scene-caption">06° N &nbsp; / &nbsp; BELOW THE SURFACE</span>
</div>

<style>
  .diver-rig { transform-origin: 276px 231px; animation: neutral-buoyancy 9s ease-in-out infinite; }
  .near-leg { transform-origin: 255px 244px; animation: fin-stroke 7s ease-in-out infinite; }
  .far-leg { transform-origin: 252px 242px; animation: fin-stroke 7s ease-in-out -3.5s infinite; }
  .rising-bubble { opacity: 0; transform-box: fill-box; transform-origin: center; animation: bubble-rise var(--duration) linear var(--delay) infinite; }
  .rising-bubble circle, circle.rising-bubble { fill: url(#bubble-glass); stroke: #b7eee2; stroke-width: .75; }
  .rising-bubble path { stroke: #e1fff2; stroke-width: .65; stroke-linecap: round; opacity: .8; }
  .ambient-bubble-field { opacity: .38; }
  .reef-fish { animation: reef-sway 11s ease-in-out infinite; }
  .light-ray { animation: light-shimmer 12s ease-in-out infinite; }
  .ray-two { animation-delay: -5s; }
  @keyframes neutral-buoyancy { 0%, 100% { transform: translate(0, 3px) rotate(.5deg); } 50% { transform: translate(2px, -7px) rotate(-1deg); } }
  @keyframes fin-stroke { 0%, 100% { transform: rotate(-1deg); } 50% { transform: rotate(3deg); } }
  @keyframes bubble-rise {
    0% { opacity: 0; transform: translate(0, 6px) scale(.55); }
    9% { opacity: .72; }
    50% { opacity: .6; transform: translate(calc(var(--drift) * .35), calc(var(--rise) * .5)) scale(.9); }
    80% { opacity: .4; }
    100% { opacity: 0; transform: translate(var(--drift), var(--rise)) scale(1.2); }
  }
  @keyframes reef-sway { 50% { transform: translate(-8px, 3px); } }
  @keyframes light-shimmer { 50% { opacity: .45; } }
  @media (prefers-reduced-motion: reduce) {
    .rising-bubble { opacity: .45; transform: translate(calc(var(--drift) * .6), calc(var(--rise) * .6)); }
  }
</style>
