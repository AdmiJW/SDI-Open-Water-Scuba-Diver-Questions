---
import Text from '../components/Text.astro';
import Search from '../components/Search.astro';
import { url } from '../lib/notes';
import '../styles/global.css';
import 'katex/dist/katex.min.css';
interface Props { title?: string; description?: string; }
const { title, description = 'Personal bilingual SDI Open Water study notes. Explore scuba diving questions, answers, and concepts in Chinese and English.' } = Astro.props;
const pageTitle = title ? `${title} · SDI Open Water Study Notes` : 'SDI Open Water Study Notes';
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en" data-language="en">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width" />
    <title>{pageTitle}</title><meta name="description" content={description} />
    <meta name="theme-color" content="#071c29" /><link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} /><meta property="og:description" content={description} /><meta property="og:type" content="website" /><meta property="og:url" content={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <script is:inline>
      (() => {
        let language = navigator.language.toLowerCase().startsWith('zh') ? 'zh' : 'en';
        try { const saved = localStorage.getItem('sdi-language'); if (saved === 'zh' || saved === 'en') language = saved; } catch {}
        document.documentElement.dataset.language = language;
        document.documentElement.lang = language === 'zh' ? 'zh-CN' : 'en';
      })();
    </script>
  </head>
  <body data-base={url()}>
    <a class="skip-link" href="#main"><Text en="Skip to content" zh="跳转到正文" /></a>
    <header class="site-header">
      <a class="brand" href={url()} aria-label="SDI Open Water Study Notes home">
        <svg width="38" height="38" viewBox="0 0 40 40" fill="none" aria-hidden="true"><circle cx="20" cy="20" r="18" stroke="currentColor" stroke-opacity=".45"/><path d="M7 22q6-8 13 0t13 0M10 28q5-5 10 0t10 0" stroke="currentColor" stroke-width="1.5"/><path d="M20 9v9m-3-3 3 3 3-3" stroke="currentColor" stroke-width="1.5"/></svg>
        <span><strong>OPEN WATER</strong><small><Text en="A diver’s study notebook" zh="潜水员的学习笔记" /></small></span>
      </a>
      <nav class="header-actions" aria-label="Main navigation" data-aria-en="Main navigation" data-aria-zh="主导航">
        <a class="chapter-link" href={url('#chapters')}><Text en="The chapters" zh="章节目录" /></a>
        <button class="search-trigger" type="button" data-open-search aria-label="Search notes" data-aria-en="Search notes" data-aria-zh="搜索笔记"><span aria-hidden="true">⌕</span><Text en="Search notes" zh="搜索笔记" /><kbd>/</kbd></button>
        <div class="language-switch" role="group" aria-label="Interface language" data-aria-en="Interface language" data-aria-zh="界面语言"><button type="button" data-language-choice="en" lang="en" aria-pressed="true">EN</button><span aria-hidden="true">/</span><button type="button" data-language-choice="zh" lang="zh-CN" aria-pressed="false">中文</button></div>
      </nav>
    </header>
    <slot />
    <footer class="site-footer"><a class="footer-brand" href={url()}>OPEN WATER <span>↘</span></a><p><Text en="Keep learning. Stay curious. Dive thoughtfully." zh="持续学习，保持好奇，认真对待每一次潜水。" /></p><a href="https://github.com/AdmiJW/SDI-Open-Water-Scuba-Diver-Questions"><Text en="Personal notes by AdmiJW ↗" zh="AdmiJW 的个人笔记 ↗" /></a></footer>
    <Search />
    <script>import '../scripts/site';</script>
  </body>
</html>
